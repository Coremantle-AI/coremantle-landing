# Copy to .env.local for local development. On Netlify, set these under
# Site configuration -> Environment variables (they are read at build time).

# PostHog product analytics. Leave the key empty to disable analytics.
NEXT_PUBLIC_POSTHOG_KEY=phc_knTydQVeUDxzacYaQsAuGjxBEXMYJzrSTqoRCqVHfaYf
# US cloud; EU accounts use https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Public address of this environment, no trailing slash. Used for canonical
# links, link previews (og:url / og:image), robots.txt and sitemap.xml.
# Local: http://localhost:3000 · dev: the dev site's URL · prod: https://coremantle.ai
# Unset on Netlify, the deploy's own address is used.
SITE_URL=http://localhost:3000

# Let search engines index this environment. Only production should be true.
# Unset, only Netlify production deploys are indexable.
ALLOW_INDEXING=false
